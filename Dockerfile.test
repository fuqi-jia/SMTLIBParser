# Test Dockerfile for Python bindings
FROM python:3.11-slim

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    libgmp-dev \
    libmpfr-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy source code
COPY . .

# Install Python package with test dependencies
RUN pip install --upgrade pip && \
    pip install -v ".[test]"

# Run tests
CMD ["pytest", "-v", "tests/python/"]
